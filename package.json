{
  "name": "meteora-api",
  "version": "0.1.0",
  "description": "Meteora API client",
  "homepage": "https://github.com/ChiefWoods/meteora-ag-api",
  "license": "MIT",
  "author": "ChiefWoods",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChiefWoods/meteora-ag-api.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "bun run generate && tsdown",
    "changeset": "changeset",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "openapi-gen": "openapi-ts -f openapi-ts.config.ts",
    "generate": "rm -rf generated && bun run openapi-gen",
    "prepare": "husky",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3"
  }
}
